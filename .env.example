# Destiny Dots environment — copy to .env (local) or paste into Vercel → Settings → Environment Variables.
# Never commit real values. Step-by-step instructions for every key: docs/PRODUCTION_SETUP.md
# In production the app refuses to start if a REQUIRED key is missing.

# ─── Core (REQUIRED) ──────────────────────────────────────────────────────────
# Postgres. Local: the URL printed by `npm run db:dev`. Production: Neon pooled connection string (§1).
DATABASE_URL=""
# Production only: Neon direct (non-pooled) connection string, used for migrations
DIRECT_URL=""
# 32+ random characters. Generate with: npm run gen:secret
BETTER_AUTH_SECRET=""
# Your site's public URL — https://destinydots.in in production (no trailing slash)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Emails that become admins when they sign up (comma-separated)
ADMIN_EMAILS="info.destinydots@gmail.com"

# ─── Payments: Razorpay (REQUIRED in production) — §2 ────────────────────────
# Test keys start with rzp_test_, live keys with rzp_live_. Subscription plans are created automatically.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ─── Email: Resend (REQUIRED in production) — §3 ─────────────────────────────
RESEND_API_KEY=""
# Must use the domain you verified in Resend
EMAIL_FROM="Destiny Dots <noreply@destinydots.in>"
# Where contact-form messages go (defaults to the public contact email)
CONTACT_INBOX="info.destinydots@gmail.com"

# ─── Bot protection: Cloudflare Turnstile (REQUIRED in production) — §4 ──────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ─── File storage: Cloudflare R2 or any S3-compatible bucket (REQUIRED in production) — §5
# Local development stores uploads in ./.storage when these are empty.
S3_ENDPOINT=""          # https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_BUCKET=""            # destiny-dots-files
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── Security (REQUIRED in production) — §6 ──────────────────────────────────
# Encrypts seller bank/UPI details. 32 bytes, base64: npm run gen:secret  (never change it once set)
ENCRYPTION_KEY=""
# Protects the scheduled job endpoints. Any long random string: npm run gen:secret
CRON_SECRET=""

# ─── Optional ────────────────────────────────────────────────────────────────
# Google sign-in — §7. Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Job imports — §8. Remotive, DEV, Hacker News and RSS need no keys.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
JOOBLE_API_KEY=""
